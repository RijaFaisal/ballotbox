# PostgreSQL connection string (Railway injects this automatically when Postgres is attached)
DATABASE_URL=postgresql://user@localhost:5432/ballotbox

# Secret used to sign admin JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real value — this file only documents the shape of .env.
JWT_SECRET_KEY=change-me

# JWT signing algorithm and access token lifetime (minutes)
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed to call the API (e.g. the Vercel frontend URL)
CORS_ORIGINS=http://localhost:5173
